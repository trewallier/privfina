# Offline / ephemeral intake dumps (never commit)
*.xlsx
*.xls
# Tiny committed fixtures for market-data Vitest (ADR 0045 BUBOR sample)
!tests/fixtures/market-data/**/*.xls
!tests/fixtures/market-data/**/*.xlsx
data/intake/**/raw/**
data/intake/**/staged/**
temp/
.tmp-market-data/
tools/market-data/.poppler-debs/

# Allow documentation and templates in data/ to be committed
!data/README.md
!data/*.template.json
!data/example*.json

