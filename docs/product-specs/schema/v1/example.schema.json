{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privfina.local/schema/v1/example.schema.json",
  "title": "Privfina Product Worked Example",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "productId", "exampleId", "title", "inputs", "expected"],
  "properties": {
    "specVersion": {
      "type": "string",
      "const": "v1alpha1"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "exampleId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "properties": {
        "paymentCount": {
          "type": "integer",
          "minimum": 0
        },
        "monthlyPayment": {
          "type": "number"
        },
        "totalInterest": {
          "type": "number"
        },
        "totalPaid": {
          "type": "number"
        },
        "annualCouponRatePct": {
          "type": "number"
        },
        "couponPaymentFrequency": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}