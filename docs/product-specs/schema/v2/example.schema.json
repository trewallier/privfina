{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privfina.local/schema/v2/example.schema.json",
  "title": "Privfina Product Worked Example v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "productId", "exampleId", "title", "inputs", "expected"],
  "properties": {
    "specVersion": {
      "type": "string",
      "const": "v2alpha1"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "exampleId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "Provenance for published/worked numbers locked in this example.",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "Stable provenance tag (for example otp-product-page-calculator, hirdetmeny-sales)."
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "description": "ISO calendar date (Europe/Budapest) when the numbers were captured."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object"
    },
    "expected": {
      "type": "object",
      "properties": {
        "paymentCount": {
          "type": "integer",
          "minimum": 0
        },
        "monthlyPayment": {
          "type": "number"
        },
        "totalInterest": {
          "type": "number"
        },
        "totalPaid": {
          "type": "number"
        },
        "annualCouponRatePct": {
          "type": "number"
        },
        "couponPaymentFrequency": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
