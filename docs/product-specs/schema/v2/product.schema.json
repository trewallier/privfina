{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privfina.local/schema/v2/product.schema.json",
  "title": "Privfina Product Specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "kind",
    "id",
    "family",
    "variant",
    "productCode",
    "displayName",
    "inputs",
    "outputs",
    "ui"
  ],
  "properties": {
    "specVersion": {
      "type": "string",
      "const": "v2alpha1"
    },
    "kind": {
      "type": "string",
      "const": "financial-product"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "enum": ["loan", "government-security", "mortgage-loan"]
    },
    "variant": {
      "type": "string",
      "minLength": 1,
      "description": "Human/product-line label for the offering. Free-form so new products do not require schema enum edits."
    },
    "productCode": {
      "type": "string",
      "minLength": 1,
      "description": "Stable machine identifier for the product (for example otp-1x1, csok-plusz, dkj)."
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "retail-government-bond",
        "treasury-bill"
      ]
    },
    "denominationCurrency": {
      "type": "string",
      "enum": ["HUF"]
    },
    "denominationUnit": {
      "type": ["string", "number"],
      "anyOf": [
        {
          "const": "face-value"
        },
        {
          "type": "number",
          "minimum": 1
        }
      ]
    },
    "issuanceModel": {
      "type": "string",
      "enum": ["discount", "par", "auction", "retail-distribution", "phased-public-offering"]
    },
    "yieldModel": {
      "type": "string",
      "enum": ["fixed", "index-linked", "auction-implied", "discount-to-par", "coupon-plus-redemption"]
    },
    "couponModel": {
      "type": "string",
      "enum": ["zero-coupon", "fixed-coupon", "floating-coupon", "none", "annual-variable", "quarterly-variable"]
    },
    "referenceIndex": {
      "type": "string",
      "enum": ["cpi", "bubor", "absent", "prior-calendar-year-average-inflation", "weighted-3m-dkj-auction-average"]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrumentType"],
      "properties": {
        "instrumentType": {
          "type": "string",
          "enum": ["loan", "government-security"]
        },
        "rateType": {
          "type": "string",
          "enum": ["fixed", "state-subsidized", "variable-with-subsidy"]
        },
        "amortizationType": {
          "type": "string",
          "enum": ["level-payment", "interest-only-then-annuity"]
        },
        "paymentFrequency": {
          "type": "string",
          "enum": ["monthly"]
        },
        "gracePeriodMonths": {
          "type": "integer",
          "minimum": 0
        },
        "interestPeriodMonths": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "subsidy": {
      "$ref": "#/$defs/subsidyDefinition"
    },
    "loanPurposes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "used-home-purchase",
          "new-home-purchase",
          "construction",
          "renovation",
          "modernization",
          "extension",
          "refinancing"
        ]
      }
    },
    "discounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/discountDefinition"
      }
    },
    "fees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feeDefinition"
      }
    },
    "eligibilityRules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pricing": {
      "type": "object",
      "description": "Optional cross-family pricing envelope. Prefer this for new commercial terms; legacy government-security top-level pricing fields remain valid in v2alpha1.",
      "additionalProperties": false,
      "properties": {
        "rateSettingRule": {
          "type": "string",
          "minLength": 1
        },
        "offeringPriceModel": {
          "type": "string",
          "minLength": 1
        },
        "offeringPackaging": {
          "type": "object",
          "description": "Hirdetmény §6 offering-faithful installment packaging (ADR 0023). When present, commercial schedule/THM use a calibrated packaging rate so representative repayments and ADR 0022 THM match published figures.",
          "additionalProperties": false,
          "required": [
            "representativePrincipal",
            "representativeTermMonths",
            "representativeOfferingMonthlyPayment"
          ],
          "properties": {
            "representativePrincipal": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "representativeTermMonths": {
              "type": "integer",
              "minimum": 1
            },
            "representativeGracePeriodMonths": {
              "type": "integer",
              "minimum": 0
            },
            "representativeOfferingMonthlyPayment": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "representativeOfferingGracePayment": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "excludeFeeNames": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "inputs": {
      "description": "User-configurable parameters for the product.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldDefinition"
      }
    },
    "derivedVariables": {
      "description": "Intermediate calculated values derived from inputs. These are internal calculations and typically should not be duplicated in outputs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldDefinition"
      }
    },
    "outputs": {
      "description": "Final results and analytics produced by the product calculation. Outputs are the primary contract with users and other components.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/fieldDefinition"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formTitle", "sections"],
      "properties": {
        "formTitle": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiSection"
          }
        }
      }
    },
    "exampleRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "investorEligibility": {
      "type": "string",
      "minLength": 1
    },
    "transferRestrictions": {
      "type": "string",
      "minLength": 1
    },
    "earlyRedemptionByIssuer": {
      "type": "boolean"
    },
    "offeringPriceModel": {
      "type": "string",
      "minLength": 1
    },
    "rateSettingRule": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family": {
            "const": "loan"
          }
        }
      },
      "then": {
        "required": ["engine"],
        "properties": {
          "engine": {
            "required": ["instrumentType", "rateType", "amortizationType", "paymentFrequency"],
            "properties": {
              "instrumentType": {
                "const": "loan"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "mortgage-loan"
          }
        }
      },
      "then": {
        "required": ["engine"],
        "properties": {
          "engine": {
            "required": ["instrumentType", "rateType", "amortizationType", "paymentFrequency"],
            "properties": {
              "instrumentType": {
                "const": "loan"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "government-security"
          }
        }
      },
      "then": {
        "required": [
          "category",
          "denominationCurrency",
          "denominationUnit",
          "issuanceModel",
          "yieldModel",
          "couponModel",
          "referenceIndex"
        ],
        "properties": {
          "engine": {
            "properties": {
              "instrumentType": {
                "const": "government-security"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "label", "required"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["number", "integer", "string", "boolean"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "unit": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
            },
            "enum": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": ["string", "number", "integer", "boolean"]
              }
            }
          }
        }
      }
    },
    "uiSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "fieldNames"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "fieldNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsidyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["none", "state-interest-subsidy"]
        },
        "customerRate": {
          "type": "number"
        },
        "subsidyDurationMonths": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "discountDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["rate-discount", "fee-waiver", "cashback"]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["bp", "percent", "amount"]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appliesToFeeNames": {
          "type": "array",
          "description": "For fee-waiver discounts: explicit fee names this waiver applies to. When omitted, fee-waivers apply only to fees with type disbursement.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "feeDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "disbursement",
            "appraisal",
            "prepayment",
            "commitment",
            "contract-modification",
            "property-management",
            "other"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": ["amount", "percent", "bp"]
        },
        "maxAmount": {
          "type": "number",
          "minimum": 0,
          "description": "Optional absolute cap applied after percent/bp evaluation (for example folyósítási díj max Ft)."
        },
        "timing": {
          "type": "string",
          "enum": ["upfront", "periodic", "on-event"]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
